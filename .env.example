# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit your actual .env file to git.
# These are the same Firebase project values used by the public
# Saad-Portfolio site - copy them from that project's .env or from
# the Vercel dashboard for this project.

VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Public site that hosts the CMS API (/api/admin: previews, rebuilds, scheduler).
# Defaults to https://www.saadmaz.com. Point it at `vercel dev` (e.g.
# http://localhost:3000) to work against a local copy of the site; that origin
# must also be in the site's ADMIN_ORIGINS and in this app's CSP connect-src.
# VITE_SITE_URL=https://www.saadmaz.com
